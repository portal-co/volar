{
    "name": "@portal-solutions/volar-runtime",
    "version": "0.1.0",
    "exports": {
        ".": {
            "types": "./dist/index.d.cts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=20"
    },
    "zshy": "src/index.ts",
    "type": "module",
    "scripts": {
        "generate": "cd ../.. && cargo generate-ts",
        "build": "npx zshy --project ../../tsconfig.json",
        "test": "npm run build && node scripts/wrapping-smoke.mjs"
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.cts"
}
